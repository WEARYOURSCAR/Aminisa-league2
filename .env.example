# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The base URL of your Supabase project (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: The anonymous API key for your Supabase project
SUPABASE_ANON_KEY=your-anon-key

# RESEND_API_KEY: The API key from Resend (https://resend.com) for sending transactional emails
RESEND_API_KEY=re_your_api_key

# RESEND_FROM_EMAIL: The verified sender email on Resend (Defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=Aminisa Sport Club <onboarding@resend.dev>
